[Unit]
Description=Bounded Deribit daily delivery pagination
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=option-collector
Group=option-collector
WorkingDirectory=/opt/option-collector/current
ExecStart=/opt/option-collector/current/.venv/bin/python -m option_collector --config /etc/option-collector/collector.toml delivery --due
TimeoutStartSec=20
TimeoutStopSec=2
KillMode=control-group
Restart=no
UMask=0077
LogNamespace=option-collector
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/option-collector
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
