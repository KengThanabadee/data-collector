[Unit]
Description=Deribit options periodic raw capture
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
User=option-collector
Group=option-collector
WorkingDirectory=/opt/option-collector/current
ExecStart=/opt/option-collector/current/.venv/bin/python -m option_collector --config /etc/option-collector/collector.toml collect-once --scheduled-slot auto
TimeoutStartSec=270
TimeoutStopSec=2
KillMode=control-group
Restart=no
UMask=0077
LogNamespace=option-collector
StateDirectory=option-collector
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/option-collector
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
